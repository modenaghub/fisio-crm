// FisioCRM — schema completo (todas as fases).
// Convenções: ids uuid · valores em centavos (Int) · datas timestamptz · organizationId em toda tabela de negócio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// PLATAFORMA: tenant, unidades, usuários, permissões, sessões
// ─────────────────────────────────────────────────────────────

enum OrganizationPlan {
  TRIAL
  SOLO
  CLINIC
  ENTERPRISE
}

model Organization {
  id                 String           @id @default(uuid()) @db.Uuid
  name               String
  slug               String           @unique
  plan               OrganizationPlan @default(TRIAL)
  timezone           String           @default("America/Sao_Paulo")
  isActive           Boolean          @default(true)
  // Retenção configurável (LGPD). null = manter indefinidamente até definição jurídica.
  dataRetentionYears Int?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  units                  Unit[]
  users                  User[]
  roles                  Role[]
  settings               BusinessSettings?
  services               Service[]
  auditLogs              AuditLog[]
  integrationConfigs     IntegrationConfig[]
  leads                  Lead[]
  patients               Patient[]
  medicalConditions      MedicalCondition[]
  appointments           Appointment[]
  recurrenceSeries       RecurrenceSeries[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  holidays               Holiday[]
  evaluations            Evaluation[]
  treatmentPlans         TreatmentPlan[]
  treatmentSessions      TreatmentSession[]
  sessionEvolutions      SessionEvolution[]
  packageTemplates       PackageTemplate[]
  packages               Package[]
  payments               Payment[]
  expenses               Expense[]
  expenseCategories      ExpenseCategory[]
  financialTransactions  FinancialTransaction[]
  conversations          Conversation[]
  messages               Message[]
  messageDispatches      MessageDispatch[]
  messageTemplates       MessageTemplate[]
  automations            Automation[]
  tasks                  Task[]
  documents              Document[]
  notifications          Notification[]
  goals                  Goal[]
  consents               Consent[]

  @@map("organizations")
}

model Unit {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  phone          String?
  email          String?
  addressLine    String?
  city           String?
  state          String?  @db.VarChar(2)
  zipCode        String?  @db.VarChar(9)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userUnits              UserUnit[]
  appointments           Appointment[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  payments               Payment[]
  expenses               Expense[]

  @@index([organizationId])
  @@map("units")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  roleId            String    @db.Uuid
  name              String
  email             String
  phone             String?
  avatarUrl         String?
  passwordHash      String
  isActive          Boolean   @default(true)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime? @db.Timestamptz(3)
  lastLoginAt       DateTime? @db.Timestamptz(3)
  passwordChangedAt DateTime? @db.Timestamptz(3)
  createdById       String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role                  Role                      @relation(fields: [roleId], references: [id])
  professional          ProfessionalProfile?
  userUnits             UserUnit[]
  permissionOverrides   UserPermissionOverride[]
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  notifications         Notification[]
  assignedTasks         Task[]                    @relation("TaskAssignee")
  responsibleLeads      Lead[]                    @relation("LeadResponsible")
  responsiblePatients   Patient[]                 @relation("PatientResponsible")
  appointments          Appointment[]             @relation("AppointmentProfessional")
  treatmentSessions     TreatmentSession[]        @relation("SessionProfessional")
  evolutionVersions     SessionEvolutionVersion[]
  evaluations           Evaluation[]
  sentMessages          Message[]
  assignedConversations Conversation[]            @relation("ConversationAssignee")

  // e-mail único por organização (o mesmo e-mail pode existir em outra clínica)
  @@unique([organizationId, email])
  @@index([email])
  @@map("users")
}

model UserUnit {
  userId String @db.Uuid
  unitId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
  @@map("user_units")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String // ADMIN, PHYSIO, RECEPTION ou personalizado
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  users        User[]

  @@unique([organizationId, key])
  @@map("roles")
}

/// Catálogo global de permissões (seed). code = "recurso.acao"
model Permission {
  code        String @id
  module      String
  description String

  roles     RolePermission[]
  overrides UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  roleId         String     @db.Uuid
  permissionCode String
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

/// Exceção individual: concede (granted=true) ou nega (granted=false) uma permissão ao usuário.
model UserPermissionOverride {
  userId         String     @db.Uuid
  permissionCode String
  granted        Boolean
  grantedById    String?    @db.Uuid
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([userId, permissionCode])
  @@map("user_permission_overrides")
}

/// Sessão de login = refresh token (armazenado com hash). familyId permite revogar a cadeia em caso de reuso.
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime  @db.Timestamptz(3)
  lastUsedAt   DateTime  @default(now()) @db.Timestamptz(3)
  rotatedAt    DateTime? @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  revokeReason String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  READ
  EXPORT
  LOGIN
  LOGIN_FAILED
  LOGOUT
  TOKEN_REUSE
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET
  PASSWORD_CHANGE
  PERMISSION_CHANGE
}

/// Somente inserção: trigger no banco bloqueia UPDATE/DELETE.
model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  actorUserId    String?     @db.Uuid
  actorName      String?
  action         AuditAction
  entity         String
  entityId       String?
  summary        String?
  changes        Json? // { campo: { from, to } }
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, entity, entityId])
  @@index([organizationId, actorUserId])
  @@map("audit_logs")
}

model BusinessSettings {
  organizationId           String          @id @db.Uuid
  clinicName               String
  logoUrl                  String?
  phone                    String?
  whatsapp                 String?
  email                    String?
  addressLine              String?
  city                     String?
  state                    String?         @db.VarChar(2)
  zipCode                  String?         @db.VarChar(9)
  defaultSessionPriceCents Int             @default(0)
  defaultSessionMinutes    Int             @default(50)
  // Regras de agendamento
  minBookingNoticeHours    Int             @default(2)
  cancellationNoticeHours  Int             @default(24)
  allowOverbooking         Boolean         @default(false)
  noShowFollowUpDays       Int             @default(7)
  acceptedPaymentMethods   PaymentMethod[] @default([PIX, CASH, CREDIT_CARD, DEBIT_CARD, BANK_TRANSFER])
  onboardingCompletedAt    DateTime?       @db.Timestamptz(3)
  onboardingStep           Int             @default(0)
  createdAt                DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

enum IntegrationProvider {
  WHATSAPP_CLOUD
  EMAIL_SMTP
  GOOGLE_CALENDAR
  PAYMENT_GATEWAY
  AI
}

enum IntegrationStatus {
  NOT_CONFIGURED
  MOCK
  ACTIVE
  ERROR
}

model IntegrationConfig {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  provider         IntegrationProvider
  status           IntegrationStatus   @default(MOCK)
  publicConfig     Json? // dados não sensíveis (ex.: número exibido)
  encryptedSecrets String? // AES-256-GCM
  lastError        String?
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@map("integration_configs")
}

enum ConsentPurpose {
  HEALTH_DATA_TREATMENT
  WHATSAPP_COMMUNICATION
  EMAIL_COMMUNICATION
  MARKETING
  IMAGE_USE
}

model Consent {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  patientId      String?        @db.Uuid
  leadId         String?        @db.Uuid
  purpose        ConsentPurpose
  termVersion    String
  channel        String // whatsapp, presencial, formulário…
  grantedAt      DateTime       @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime?      @db.Timestamptz(3)
  evidence       Json? // ex.: id da mensagem, IP

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient?     @relation(fields: [patientId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@index([organizationId, patientId])
  @@map("consents")
}

// ─────────────────────────────────────────────────────────────
// CADASTROS BASE: serviços, profissionais, disponibilidade
// ─────────────────────────────────────────────────────────────

enum ServiceKind {
  EVALUATION
  SESSION
  PACKAGE
  OTHER
}

model Service {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @db.Uuid
  name            String
  kind            ServiceKind @default(SESSION)
  durationMinutes Int         @default(50)
  priceCents      Int         @default(0)
  color           String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  recurrenceSeries RecurrenceSeries[]

  @@index([organizationId])
  @@map("services")
}

model ProfessionalProfile {
  userId             String   @id @db.Uuid
  crefito            String?
  specialties        String[]
  bio                String?
  calendarColor      String   @default("#0f766e")
  // Integração Google Calendar por profissional (Fase 5)
  externalCalendarId String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("professional_profiles")
}

/// Disponibilidade semanal. professionalId null = regra da unidade.
model AvailabilityRule {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  unitId         String   @db.Uuid
  professionalId String?  @db.Uuid
  weekday        Int // 0=domingo … 6=sábado
  startTime      String   @db.VarChar(5) // "08:00"
  endTime        String   @db.VarChar(5) // "12:00"
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([organizationId, unitId, weekday])
  @@map("availability_rules")
}

enum AvailabilityExceptionKind {
  DAY_OFF
  VACATION
  BLOCK
  BREAK
  SPECIAL_HOURS
  EXTRA_HOURS
}

model AvailabilityException {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @db.Uuid
  unitId         String                    @db.Uuid
  professionalId String?                   @db.Uuid
  kind           AvailabilityExceptionKind
  startsAt       DateTime                  @db.Timestamptz(3)
  endsAt         DateTime                  @db.Timestamptz(3)
  reason         String?
  createdById    String?                   @db.Uuid
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([organizationId, startsAt])
  @@map("availability_exceptions")
}

model Holiday {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  date           DateTime @db.Date
  name           String
  isRecurring    Boolean  @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@map("holidays")
}

// ─────────────────────────────────────────────────────────────
// CRM: leads e pacientes
// ─────────────────────────────────────────────────────────────

enum LeadStage {
  NEW_CONTACT // 1. Novo contato
  FIRST_SERVICE // 2. Primeiro atendimento
  DATA_COLLECTED // 3. Dados coletados
  EVALUATION_SCHEDULED // 4. Avaliação agendada
  EVALUATION_DONE // 5. Avaliação realizada
  CONVERTED // virou paciente → card segue em patients.crmStage
  LOST
}

enum PatientStage {
  TREATMENT_STARTED // 6. Tratamento iniciado
  ACTIVE // 7. Paciente ativo
  IN_TREATMENT // 8. Tratamento em andamento
  DISCHARGED // 9. Alta
  INACTIVE // 10. Paciente inativo
  REACTIVATION // 11. Reativação
}

enum LeadSource {
  WHATSAPP
  INSTAGRAM
  GOOGLE
  REFERRAL
  DOCTOR_REFERRAL
  WEBSITE
  WALK_IN
  PHONE
  OTHER
}

enum LeadTemperature {
  COLD
  WARM
  HOT
}

model Lead {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  name           String
  phone          String
  /// Somente dígitos do telefone, para busca e deduplicação
  phoneDigits    String?
  email          String?
  cpfEncrypted   String?
  cpfHash        String?
  birthDate      DateTime?        @db.Date
  source         LeadSource       @default(OTHER)
  sourceDetail   String?
  stage          LeadStage        @default(NEW_CONTACT)
  temperature    LeadTemperature?
  reason         String? // motivo do contato
  bodyRegion     String?
  hasDiagnosis   Boolean?
  previousPhysio Boolean?
  intakeAnswers  Json? // respostas completas do bot
  firstContactAt DateTime         @default(now()) @db.Timestamptz(3)
  lastContactAt  DateTime?        @db.Timestamptz(3)
  lostReason     String?
  responsibleId  String?          @db.Uuid
  patientId      String?          @unique @db.Uuid
  convertedAt    DateTime?        @db.Timestamptz(3)
  position       Int              @default(0) // ordem no Kanban
  createdById    String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?        @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsible   User?          @relation("LeadResponsible", fields: [responsibleId], references: [id])
  patient       Patient?       @relation(fields: [patientId], references: [id])
  conversations Conversation[]
  tasks         Task[]
  consents      Consent[]

  @@index([organizationId, stage])
  @@index([organizationId, phone])
  @@map("leads")
}

enum Sex {
  FEMALE
  MALE
  OTHER
  NOT_INFORMED
}

model Patient {
  id                    String       @id @default(uuid()) @db.Uuid
  organizationId        String       @db.Uuid
  code                  Int // código sequencial por organização (ex.: P-0042)
  name                  String
  socialName            String?
  cpfEncrypted          String?
  cpfHash               String?
  birthDate             DateTime?    @db.Date
  sex                   Sex          @default(NOT_INFORMED)
  phone                 String?
  whatsapp              String?
  /// Dígitos de telefone + WhatsApp, para busca (mantido pela aplicação)
  phoneDigits           String?
  email                 String?
  photoUrl              String?
  profession            String?
  addressLine           String?
  city                  String?
  state                 String?      @db.VarChar(2)
  zipCode               String?      @db.VarChar(9)
  emergencyContactName  String?
  emergencyContactPhone String?
  source                LeadSource   @default(OTHER)
  crmStage              PatientStage @default(TREATMENT_STARTED)
  responsibleId         String?      @db.Uuid
  lastContactAt         DateTime?    @db.Timestamptz(3)
  notes                 String?
  createdById           String?      @db.Uuid
  updatedById           String?      @db.Uuid
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime?    @db.Timestamptz(3)
  anonymizedAt          DateTime?    @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  responsible       User?              @relation("PatientResponsible", fields: [responsibleId], references: [id])
  lead              Lead?
  clinicalProfile   ClinicalProfile?
  conditions        PatientCondition[]
  evaluations       Evaluation[]
  treatmentPlans    TreatmentPlan[]
  treatmentSessions TreatmentSession[]
  appointments      Appointment[]
  recurrenceSeries  RecurrenceSeries[]
  packages          Package[]
  payments          Payment[]
  conversations     Conversation[]
  tasks             Task[]
  documents         Document[]
  consents          Consent[]

  @@unique([organizationId, code])
  @@unique([organizationId, cpfHash])
  @@index([organizationId, crmStage])
  @@index([organizationId, name])
  @@index([organizationId, phone])
  @@map("patients")
}

// ─────────────────────────────────────────────────────────────
// CLÍNICO: condições, avaliação, plano, sessões, evolução
// ─────────────────────────────────────────────────────────────

enum ConditionType {
  DISEASE
  INJURY
  PATHOLOGY
  SURGERY
  MEDICATION
  ALLERGY
  OTHER
}

/// Catálogo de condições da organização (opcionalmente com CID-10).
model MedicalCondition {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  name           String
  type           ConditionType
  icd10Code      String?       @db.VarChar(8)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patients     PatientCondition[]

  @@unique([organizationId, name, type])
  @@map("medical_conditions")
}

model PatientCondition {
  id          String        @id @default(uuid()) @db.Uuid
  patientId   String        @db.Uuid
  conditionId String?       @db.Uuid
  type        ConditionType
  description String
  bodyRegion  String?
  laterality  String? // direito, esquerdo, bilateral
  since       DateTime?     @db.Date
  isActive    Boolean       @default(true)
  notes       String?
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  condition MedicalCondition? @relation(fields: [conditionId], references: [id])

  @@index([patientId])
  @@map("patient_conditions")
}

model ClinicalProfile {
  patientId         String   @id @db.Uuid
  mainComplaint     String?
  diagnosis         String?
  medicalHistory    String?
  medications       String?
  allergies         String?
  contraindications String?
  observations      String?
  updatedById       String?  @db.Uuid
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("clinical_profiles")
}

enum EvaluationType {
  INITIAL
  FOLLOW_UP
  DISCHARGE
}

model Evaluation {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  patientId      String         @db.Uuid
  professionalId String         @db.Uuid
  appointmentId  String?        @unique @db.Uuid
  type           EvaluationType @default(INITIAL)
  performedAt    DateTime       @db.Timestamptz(3)
  painScale      Int? // EVA 0–10
  mainComplaint  String?
  mobility       Json? // { segmento: descrição }
  strength       Json? // { grupo muscular: grau 0–5 }
  rangeOfMotion  Json? // { articulação/movimento: graus }
  tests          Json? // [{ nome, resultado }]
  scales         Json? // [{ nome, pontuação }]
  otherParams    Json?
  conclusion     String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?      @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient        Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional   User            @relation(fields: [professionalId], references: [id])
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id])
  treatmentPlans TreatmentPlan[]

  @@index([organizationId, patientId, performedAt])
  @@map("evaluations")
}

enum TreatmentPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model TreatmentPlan {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  patientId        String              @db.Uuid
  evaluationId     String?             @db.Uuid
  objective        String
  treatment        String
  frequencyPerWeek Int?
  plannedSessions  Int?
  startDate        DateTime?           @db.Date
  expectedEndDate  DateTime?           @db.Date
  status           TreatmentPlanStatus @default(ACTIVE)
  observations     String?
  createdById      String?             @db.Uuid
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  evaluation   Evaluation?        @relation(fields: [evaluationId], references: [id])
  sessions     TreatmentSession[]

  @@index([organizationId, patientId])
  @@map("treatment_plans")
}

/// Sessão efetivamente realizada (1:1 com o agendamento atendido).
model TreatmentSession {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  patientId       String   @db.Uuid
  professionalId  String   @db.Uuid
  appointmentId   String?  @unique @db.Uuid
  treatmentPlanId String?  @db.Uuid
  sessionNumber   Int
  performedAt     DateTime @db.Timestamptz(3)
  durationMinutes Int?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional  User              @relation("SessionProfessional", fields: [professionalId], references: [id])
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id])
  treatmentPlan TreatmentPlan?    @relation(fields: [treatmentPlanId], references: [id])
  evolution     SessionEvolution?
  packageUsage  PackageSession?

  @@unique([patientId, sessionNumber])
  @@index([organizationId, performedAt])
  @@map("treatment_sessions")
}

/// Evolução da sessão. O conteúdo vigente é a última versão; versões anteriores nunca são apagadas.
model SessionEvolution {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  sessionId      String    @unique @db.Uuid
  currentVersion Int       @default(1)
  deletedAt      DateTime? @db.Timestamptz(3)
  deletedById    String?   @db.Uuid
  deleteReason   String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      TreatmentSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  versions     SessionEvolutionVersion[]

  @@map("session_evolutions")
}

/// Imutável (trigger bloqueia UPDATE/DELETE).
model SessionEvolutionVersion {
  id                String   @id @default(uuid()) @db.Uuid
  evolutionId       String   @db.Uuid
  version           Int
  complaint         String?
  patientState      String?
  painScale         Int?
  procedures        String?
  exercises         String?
  techniques        String?
  treatmentResponse String?
  evolutionText     String // "Evolução / Observações do atendimento" (campo livre)
  guidance          String?
  nextSteps         String?
  editReason        String?
  authorId          String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  evolution SessionEvolution @relation(fields: [evolutionId], references: [id], onDelete: Restrict)
  author    User             @relation(fields: [authorId], references: [id])

  @@unique([evolutionId, version])
  @@map("session_evolution_versions")
}

// ─────────────────────────────────────────────────────────────
// AGENDA
// ─────────────────────────────────────────────────────────────

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED
  NO_SHOW
  RESCHEDULED
  BLOCKED // bloqueio de horário
}

model RecurrenceSeries {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  patientId       String    @db.Uuid
  professionalId  String    @db.Uuid
  serviceId       String?   @db.Uuid
  packageId       String?   @db.Uuid
  weekdays        Int[] // [2,4] = terça e quinta
  startTime       String    @db.VarChar(5)
  durationMinutes Int
  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date
  occurrences     Int?
  isActive        Boolean   @default(true)
  createdById     String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [serviceId], references: [id])
  appointments Appointment[]

  @@map("recurrence_series")
}

model Appointment {
  id                String            @id @default(uuid()) @db.Uuid
  organizationId    String            @db.Uuid
  unitId            String            @db.Uuid
  professionalId    String            @db.Uuid
  patientId         String?           @db.Uuid // null quando for bloqueio
  serviceId         String?           @db.Uuid
  packageId         String?           @db.Uuid
  seriesId          String?           @db.Uuid
  startsAt          DateTime          @db.Timestamptz(3)
  endsAt            DateTime          @db.Timestamptz(3)
  status            AppointmentStatus @default(SCHEDULED)
  priceCents        Int               @default(0)
  notes             String?
  cancelReason      String?
  rescheduledFromId String?           @db.Uuid
  confirmedAt       DateTime?         @db.Timestamptz(3)
  reminder24hSentAt DateTime?         @db.Timestamptz(3)
  reminder2hSentAt  DateTime?         @db.Timestamptz(3)
  externalEventId   String? // Google Calendar
  createdById       String?           @db.Uuid
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit             Unit                       @relation(fields: [unitId], references: [id])
  professional     User                       @relation("AppointmentProfessional", fields: [professionalId], references: [id])
  patient          Patient?                   @relation(fields: [patientId], references: [id])
  service          Service?                   @relation(fields: [serviceId], references: [id])
  package          Package?                   @relation(fields: [packageId], references: [id])
  series           RecurrenceSeries?          @relation(fields: [seriesId], references: [id])
  rescheduledFrom  Appointment?               @relation("Reschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo    Appointment[]              @relation("Reschedule")
  statusHistory    AppointmentStatusHistory[]
  treatmentSession TreatmentSession?
  evaluation       Evaluation?
  payments         Payment[]

  @@index([organizationId, startsAt])
  @@index([organizationId, professionalId, startsAt])
  @@index([organizationId, patientId, startsAt])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id            String             @id @default(uuid()) @db.Uuid
  appointmentId String             @db.Uuid
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus
  changedById   String?            @db.Uuid
  channel       String? // sistema, whatsapp (botão CONFIRMAR), recepção…
  reason        String?
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_status_history")
}

// ─────────────────────────────────────────────────────────────
// FINANCEIRO
// ─────────────────────────────────────────────────────────────

enum PaymentMethod {
  PIX
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  BOLETO
  HEALTH_INSURANCE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
  REFUNDED
}

model PackageTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  sessions       Int
  priceCents     Int
  validityDays   Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packages     Package[]

  @@map("package_templates")
}

enum PackageStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

/// Pacote vendido a um paciente. Sessões restantes = contracted - usadas (package_sessions).
model Package {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @db.Uuid
  patientId          String        @db.Uuid
  templateId         String?       @db.Uuid
  name               String
  contractedSessions Int
  totalPriceCents    Int
  startDate          DateTime      @db.Date
  expectedEndDate    DateTime?     @db.Date
  status             PackageStatus @default(ACTIVE)
  createdById        String?       @db.Uuid
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  template     PackageTemplate? @relation(fields: [templateId], references: [id])
  usages       PackageSession[]
  appointments Appointment[]
  payments     Payment[]

  @@index([organizationId, patientId])
  @@map("packages")
}

model PackageSession {
  id         String    @id @default(uuid()) @db.Uuid
  packageId  String    @db.Uuid
  sessionId  String    @unique @db.Uuid
  usedAt     DateTime  @default(now()) @db.Timestamptz(3)
  reversedAt DateTime? @db.Timestamptz(3)

  package Package          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  session TreatmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@map("package_sessions")
}

enum RevenueKind {
  SESSION
  EVALUATION
  PACKAGE
  OTHER
}

/// Conta a receber.
model Payment {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  unitId          String?        @db.Uuid
  patientId       String?        @db.Uuid
  appointmentId   String?        @db.Uuid
  packageId       String?        @db.Uuid
  kind            RevenueKind    @default(SESSION)
  description     String
  amountCents     Int
  paidCents       Int            @default(0)
  dueDate         DateTime       @db.Date
  status          PaymentStatus  @default(PENDING)
  method          PaymentMethod?
  paidAt          DateTime?      @db.Timestamptz(3)
  installment     Int?
  installments    Int?
  gatewayChargeId String?
  notes           String?
  createdById     String?        @db.Uuid
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit         Unit?                  @relation(fields: [unitId], references: [id])
  patient      Patient?               @relation(fields: [patientId], references: [id])
  appointment  Appointment?           @relation(fields: [appointmentId], references: [id])
  package      Package?               @relation(fields: [packageId], references: [id])
  transactions FinancialTransaction[]

  @@index([organizationId, dueDate])
  @@index([organizationId, status])
  @@map("payments")
}

model ExpenseCategory {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String // Aluguel, Funcionários, Equipamentos, Materiais, Marketing, Software, Impostos, Outros
  isSystem       Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, name])
  @@map("expense_categories")
}

model Expense {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  unitId         String?        @db.Uuid
  categoryId     String         @db.Uuid
  description    String
  amountCents    Int
  paidCents      Int            @default(0)
  dueDate        DateTime       @db.Date
  status         PaymentStatus  @default(PENDING)
  method         PaymentMethod?
  paidAt         DateTime?      @db.Timestamptz(3)
  isRecurring    Boolean        @default(false)
  supplier       String?
  notes          String?
  createdById    String?        @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit         Unit?                  @relation(fields: [unitId], references: [id])
  category     ExpenseCategory        @relation(fields: [categoryId], references: [id])
  transactions FinancialTransaction[]

  @@index([organizationId, dueDate])
  @@map("expenses")
}

enum TransactionDirection {
  IN
  OUT
}

/// Livro-caixa: cada movimentação efetiva de dinheiro.
model FinancialTransaction {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  direction      TransactionDirection
  amountCents    Int
  method         PaymentMethod
  occurredAt     DateTime             @db.Timestamptz(3)
  paymentId      String?              @db.Uuid
  expenseId      String?              @db.Uuid
  description    String?
  createdById    String?              @db.Uuid
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment      Payment?     @relation(fields: [paymentId], references: [id])
  expense      Expense?     @relation(fields: [expenseId], references: [id])

  @@index([organizationId, occurredAt])
  @@map("financial_transactions")
}

enum GoalMetric {
  REVENUE
  SESSIONS
  NEW_PATIENTS
}

model Goal {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  metric         GoalMetric
  periodStart    DateTime   @db.Date
  periodEnd      DateTime   @db.Date
  target         Int // centavos para REVENUE; quantidade para os demais
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, periodStart])
  @@map("goals")
}

// ─────────────────────────────────────────────────────────────
// COMUNICAÇÃO, AUTOMAÇÃO, TAREFAS, DOCUMENTOS, NOTIFICAÇÕES
// ─────────────────────────────────────────────────────────────

enum Channel {
  WHATSAPP
  EMAIL
  SMS
  INTERNAL
}

enum ConversationStatus {
  BOT // bot coletando dados
  OPEN // aguardando atendimento humano
  ASSIGNED
  CLOSED
}

model Conversation {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @db.Uuid
  channel             Channel
  externalContact     String // telefone E.164 ou e-mail
  patientId           String?            @db.Uuid
  leadId              String?            @db.Uuid
  status              ConversationStatus @default(OPEN)
  botState            Json? // passo atual + respostas do fluxo de cadastro
  assignedToId        String?            @db.Uuid
  lastMessageAt       DateTime?          @db.Timestamptz(3)
  // WhatsApp: mensagens livres só dentro da janela de 24 h após a última mensagem do cliente
  serviceWindowEndsAt DateTime?          @db.Timestamptz(3)
  /// Mensagens recebidas ainda não vistas pela equipe
  unreadCount         Int                @default(0)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient?          @relation(fields: [patientId], references: [id])
  lead         Lead?             @relation(fields: [leadId], references: [id])
  assignedTo   User?             @relation("ConversationAssignee", fields: [assignedToId], references: [id])
  messages     Message[]
  dispatches   MessageDispatch[]

  @@unique([organizationId, channel, externalContact])
  @@map("conversations")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

model Message {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  conversationId String?          @db.Uuid
  channel        Channel
  direction      MessageDirection
  to             String?
  from           String?
  subject        String?
  body           String
  templateId     String?          @db.Uuid
  status         MessageStatus    @default(QUEUED)
  externalId     String?
  errorMessage   String?
  isAutomated    Boolean          @default(false)
  isMock         Boolean          @default(false)
  sentById       String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation?    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  template     MessageTemplate? @relation(fields: [templateId], references: [id])
  sentBy       User?            @relation(fields: [sentById], references: [id])

  @@index([organizationId, createdAt])
  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Envio automático já feito (idempotência de lembretes e avisos: um por chave + entidade).
model MessageDispatch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String // reminder_24h, reminder_2h, …
  entityId       String   @db.Uuid
  conversationId String?  @db.Uuid
  messageId      String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([organizationId, key, entityId])
  @@index([conversationId, createdAt])
  @@map("message_dispatches")
}

model MessageTemplate {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @db.Uuid
  key                  String // reminder_24h, reminder_2h, no_show, post_session, no_return, welcome_bot…
  channel              Channel
  name                 String
  body                 String // variáveis: {{paciente}}, {{data}}, {{hora}}, {{clinica}}
  buttons              String[] // ex.: CONFIRMAR, REAGENDAR, CANCELAR
  whatsappTemplateName String? // nome do template aprovado na Meta
  isActive             Boolean  @default(true)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([organizationId, key, channel])
  @@map("message_templates")
}

enum AutomationTrigger {
  APPOINTMENT_BEFORE // X horas antes
  APPOINTMENT_DONE
  APPOINTMENT_NO_SHOW
  PATIENT_NO_RETURN // X dias sem próxima sessão
  PACKAGE_LOW_BALANCE // restam N sessões
  PAYMENT_OVERDUE
  NEW_LEAD
  LOW_OCCUPANCY
  GOAL_REACHED
}

/// SE (trigger + conditions) ENTÃO (actions). actions = [{ type: SEND_MESSAGE|NOTIFY|CREATE_TASK, ... }]
model Automation {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  name           String
  trigger        AutomationTrigger
  conditions     Json              @default("{}")
  actions        Json              @default("[]")
  isActive       Boolean           @default(true)
  createdById    String?           @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@map("automations")
}

model AutomationRun {
  id           String   @id @default(uuid()) @db.Uuid
  automationId String   @db.Uuid
  entity       String
  entityId     String
  success      Boolean
  output       Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  // idempotência: a mesma automação não roda duas vezes para a mesma entidade/evento
  @@unique([automationId, entity, entityId])
  @@map("automation_runs")
}

enum TaskType {
  CALL
  CONFIRM_APPOINTMENT
  COLLECT_PAYMENT
  RESCHEDULE
  CONTACT_LEAD
  REQUEST_DOCUMENT
  EVALUATION
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  title          String
  type           TaskType     @default(OTHER)
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(OPEN)
  dueAt          DateTime?    @db.Timestamptz(3)
  notes          String?
  assigneeId     String?      @db.Uuid
  patientId      String?      @db.Uuid
  leadId         String?      @db.Uuid
  automationId   String?      @db.Uuid
  completedAt    DateTime?    @db.Timestamptz(3)
  createdById    String?      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  patient      Patient?     @relation(fields: [patientId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])

  @@index([organizationId, status, dueAt])
  @@map("tasks")
}

enum DocumentCategory {
  EXAM
  EVALUATION
  CONSENT_TERM
  PERSONAL_DOCUMENT
  IMAGE
  REPORT
  OTHER
}

model Document {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  patientId      String           @db.Uuid
  category       DocumentCategory
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String // caminho no storage S3-compatível
  isClinical     Boolean          @default(true) // exige clinical.read para visualizar
  description    String?
  uploadedById   String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  deletedAt      DateTime?        @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId, patientId])
  @@map("documents")
}

enum NotificationType {
  NEW_PATIENT
  NEW_LEAD
  NEW_MESSAGE
  APPOINTMENT_SOON
  NO_SHOW
  PAYMENT_OVERDUE
  PACKAGE_ENDING
  NO_RETURN
  GOAL_REACHED
  TASK_ASSIGNED
  SYSTEM
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  type           NotificationType
  title          String
  body           String?
  link           String?
  readAt         DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}
