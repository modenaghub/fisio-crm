# Copie para .env e preencha. NUNCA versione o .env.

# Banco
POSTGRES_PASSWORD=troque-esta-senha

# Segredos da API — gere com:
#   openssl rand -base64 48   (JWT_SECRET e DATA_HASH_KEY)
#   openssl rand -base64 32   (DATA_ENCRYPTION_KEY — exatamente 32 bytes)
# ATENÇÃO: perder DATA_ENCRYPTION_KEY torna os CPFs cifrados irrecuperáveis. Guarde em cofre de segredos.
JWT_SECRET=
DATA_ENCRYPTION_KEY=
DATA_HASH_KEY=

# Endereço público do sistema (usado nos links de convite e redefinição de senha)
WEB_URL=http://localhost:8080

# "production" em produção. Use "development" para testar localmente com a caixa de e-mails de demonstração.
NODE_ENV=production

# Integrações: "mock" = modo demonstração, nada é enviado de verdade.
EMAIL_PROVIDER=mock
WHATSAPP_PROVIDER=mock

# Desenvolvimento local (sem Docker):
DATABASE_URL="postgresql://fisio:fisio@localhost:5432/fisio?schema=public"
